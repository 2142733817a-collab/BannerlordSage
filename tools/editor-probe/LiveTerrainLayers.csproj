<Project>
  <PropertyGroup><BaseIntermediateOutputPath>obj/Live/</BaseIntermediateOutputPath></PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>BannerlordSage.EditorProbe.Live</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <OutputPath>bin/Live/$(Configuration)/</OutputPath>
  </PropertyGroup>
  <Target Name="RequireGameDir" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameDir)' == ''" Text="Pass -p:GameDir with the real local Bannerlord installation." />
  </Target>
  <ItemGroup>
    <Compile Include="LiveTerrainLayers.cs" />
    <Compile Include="LiveTerrainSurfaces.cs" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="TaleWorlds.MountAndBlade"><HintPath>$(GameDir)/bin/Win64_Shipping_wEditor/TaleWorlds.MountAndBlade.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Engine"><HintPath>$(GameDir)/bin/Win64_Shipping_wEditor/TaleWorlds.Engine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Library"><HintPath>$(GameDir)/bin/Win64_Shipping_wEditor/TaleWorlds.Library.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.DotNet"><HintPath>$(GameDir)/bin/Win64_Shipping_wEditor/TaleWorlds.DotNet.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(GameDir)/bin/Win64_Shipping_wEditor/Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="netstandard"><HintPath>$(GameDir)/bin/Win64_Shipping_wEditor/mono/lib/mono/4.7.2-api/Facades/netstandard.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
